<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="HangLater.Windows.Views.IdeaDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Hang an Idea" Width="560" Height="270" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{DynamicResource PaperBrush}" Icon="/Resources/HangLater.ico" xmlns:views="clr-namespace:HangLater.Windows.Views;assembly=HangLater">
  <Grid Margin="28">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Name="Heading" Text="HANG AN IDEA" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="24" />
    <TextBox Name="IdeaText" Grid.Row="1" Margin="0,20,0,20" FontSize="20" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Center" />
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Name="CancelButton" Margin="0,0,8,0" Click="Cancel_Click">Cancel</Button>
      <Button Name="HangButton" Click="Hang_Click">Hang it</Button>
    </StackPanel>
  </Grid>
</Window>