<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="HangLater.Windows.Views.TaskEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Edit" Width="650" Height="660" WindowStartupLocation="CenterOwner" Background="{DynamicResource PaperBrush}" Icon="/Resources/HangLater.ico" xmlns:views="clr-namespace:HangLater.Windows.Views;assembly=HangLater">
  <ScrollViewer>
    <Grid Margin="30">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock Name="Heading" Text="EDIT" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="24" />
      <StackPanel Grid.Row="1" Margin="0,20,0,0">
        <TextBlock Name="TitleLabel" />
        <TextBox Name="TitleText" Margin="0,6,0,0" />
      </StackPanel>
      <StackPanel Grid.Row="2" Margin="0,16,0,0">
        <TextBlock Name="LinkLabel" />
        <TextBox Name="LinkText" Margin="0,6,0,0" />
      </StackPanel>
      <StackPanel Grid.Row="3" Margin="0,16,0,0">
        <TextBlock Name="NoteLabel" />
        <TextBox Name="NoteText" Margin="0,6,0,0" AcceptsReturn="True" Height="95" TextWrapping="Wrap" />
      </StackPanel>
      <StackPanel Grid.Row="4" Margin="0,16,0,0">
        <TextBlock Name="TypeLabel" />
        <ComboBox Name="TypeBox" Margin="0,6,0,0" DisplayMemberPath="name" />
      </StackPanel>
      <CheckBox Name="ReminderCheck" Grid.Row="5" Margin="0,18,0,0" Checked="ReminderCheck_Changed" Unchecked="ReminderCheck_Changed" />
      <Grid Name="ReminderTimePanel" Row="6" Margin="0,12,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition />
          <ColumnDefinition Width="140" />
        </Grid.ColumnDefinitions>
        <DatePicker Name="DueDate" />
        <TextBox Name="DueTime" Grid.Column="1" Margin="12,0,0,0" />
      </Grid>
      <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
        <Button Name="CancelButton" Margin="0,0,8,0" Click="Cancel_Click" />
        <Button Name="SaveButton" Click="Save_Click" />
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Window>