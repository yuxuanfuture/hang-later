<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="HangLater.Windows.Views.DesktopLineWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Hang Later — Desktop clothesline" Width="1200" Height="420" WindowStyle="None" AllowsTransparency="True" Background="#00FFFFFF" ShowInTaskbar="False" ShowActivated="False" Topmost="True" ResizeMode="NoResize" AllowDrop="True" xmlns:views="clr-namespace:HangLater.Windows.Views;assembly=HangLater" DragOver="Window_DragOver" DragLeave="Window_DragLeave" Drop="Window_Drop">
  <Window.Resources>
    <LinearGradientBrush x:Key="DesktopRopeFadeMask" StartPoint="0,0.5" EndPoint="1,0.5">
      <GradientStop Color="#00FFFFFF" Offset="0" />
      <GradientStop Color="#FFFFFFFF" Offset="0.08" />
      <GradientStop Color="#FFFFFFFF" Offset="0.92" />
      <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>
  </Window.Resources>
  <Border>
    <Canvas Name="LineCanvas" ClipToBounds="False">
      <!-- Only enabled during an external pointer drag: it lets a real OLE DragOver
           reach this layered window without leaving an idle clickable rectangle. -->
      <Rectangle Name="ExternalDragProbe" Width="{Binding ActualWidth, ElementName=LineCanvas}" Height="{Binding ActualHeight, ElementName=LineCanvas}"
                 Fill="#01000000" Visibility="Collapsed" IsHitTestVisible="False" Canvas.ZIndex="-1" />
      <Path Name="DesktopRopeHit" Stroke="#01000000" StrokeThickness="18" IsHitTestVisible="False" />
      <Path Name="DesktopRopeShadow" Stroke="#000000" StrokeThickness="1.4" Opacity="0.22" IsHitTestVisible="False" OpacityMask="{StaticResource DesktopRopeFadeMask}">
        <Path.Effect>
          <BlurEffect Radius="1.2" />
        </Path.Effect>
        <Path.RenderTransform>
          <TranslateTransform Y="1.2" />
        </Path.RenderTransform>
      </Path>
      <Path Name="DesktopRope" Stroke="#8C8C8C" StrokeThickness="1.2" IsHitTestVisible="False" OpacityMask="{StaticResource DesktopRopeFadeMask}" />
      <Path Name="DesktopRopeHighlight" Stroke="#FFFFFF" StrokeThickness="0.4" Opacity="0.45" IsHitTestVisible="False" OpacityMask="{StaticResource DesktopRopeFadeMask}">
        <Path.RenderTransform>
          <TranslateTransform Y="-0.35" />
        </Path.RenderTransform>
      </Path>
      <Border Name="DropZone" Canvas.Top="55" Width="225" Height="51" Background="#DDE9E3D3" Visibility="Collapsed">
        <Grid>
          <Rectangle Stroke="#171715" StrokeThickness="1.5" StrokeDashArray="4.5,3" />
          <TextBlock Name="DropText" Text="📌  DRAG SOMETHING HERE" Foreground="#171715" FontSize="10.5" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Grid>
      </Border>
    </Canvas>
  </Border>
</Window>
