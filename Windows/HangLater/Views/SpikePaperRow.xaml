<UserControl x:Class="HangLater.Windows.Controls.SpikePaperRow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             Focusable="False" Margin="0,0,0,9">
  <UserControl.Resources>
    <Style x:Key="PaperButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0.8" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.72" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.55" /></Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderThickness" Value="1.5" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PaperSizeSlider" TargetType="Slider">
      <Setter Property="Height" Value="14" />
      <Setter Property="Width" Value="112" />
      <Setter Property="IsMoveToPointEnabled" Value="True" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Background="Transparent">
              <Border Height="1" Margin="3,0" Background="{TemplateBinding Foreground}" Opacity="0.16" VerticalAlignment="Center" />
              <primitives:TickBar Height="7" Margin="3,0" Fill="{TemplateBinding Foreground}" Opacity="0.25" Placement="Bottom"
                                  Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" TickFrequency="0.05" VerticalAlignment="Center" />
              <primitives:Track x:Name="PART_Track">
                <primitives:Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></primitives:Track.DecreaseRepeatButton>
                <primitives:Track.Thumb>
                  <Thumb Width="7" Height="14">
                    <Thumb.Template><ControlTemplate TargetType="Thumb">
                      <Border x:Name="Grip" CornerRadius="3.5" Background="#FAFAF5" BorderBrush="#35000000" BorderThickness="0.6">
                        <Border.Effect><DropShadowEffect BlurRadius="2" ShadowDepth="1" Opacity="0.22" /></Border.Effect>
                      </Border>
                      <ControlTemplate.Triggers><Trigger Property="IsDragging" Value="True"><Setter TargetName="Grip" Property="Background" Value="#FFFFFF" /></Trigger></ControlTemplate.Triggers>
                    </ControlTemplate></Thumb.Template>
                  </Thumb>
                </primitives:Track.Thumb>
                <primitives:Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></primitives:Track.IncreaseRepeatButton>
              </primitives:Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </UserControl.Resources>
  <Border x:Name="Paper" BorderThickness="0.8" Padding="11">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="12" /><ColumnDefinition Width="11" /><ColumnDefinition Width="34" />
        <ColumnDefinition Width="11" /><ColumnDefinition Width="*" /><ColumnDefinition Width="11" /><ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Border x:Name="DragHandle" Background="Transparent" Cursor="SizeAll" VerticalAlignment="Stretch">
        <Border x:Name="DragGlyph" Width="12" Height="12" VerticalAlignment="Center">
          <Border.OpacityMask><ImageBrush ImageSource="/HangLater;component/Resources/SidebarIcons/light/clothesline.png" Stretch="Uniform" /></Border.OpacityMask>
        </Border>
      </Border>
      <Button x:Name="OpenButton" Grid.Column="2" Width="34" Height="42" Style="{StaticResource PaperButton}" Padding="0" BorderThickness="0">
        <Border x:Name="DocumentIcon" Width="22" Height="22">
          <Border.OpacityMask><ImageBrush ImageSource="/HangLater;component/Resources/spike-document-text.png" Stretch="Uniform" /></Border.OpacityMask>
        </Border>
      </Button>
      <StackPanel Grid.Column="4" VerticalAlignment="Center">
        <TextBlock x:Name="TitleLabel" FontFamily="{StaticResource DisplayFont}" FontSize="12" FontWeight="Bold" FontStretch="Condensed"
                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        <TextBlock x:Name="TimeLabel" FontSize="8" Margin="0,5,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="20" LineHeight="10" />
        <StackPanel x:Name="SizeControls" Orientation="Horizontal" Margin="0,5,0,0">
          <TextBlock x:Name="SmallLabel" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
          <Slider x:Name="SizeSlider" Style="{StaticResource PaperSizeSlider}" Minimum="0.6" Maximum="1.5" TickFrequency="0.05" IsSnapToTickEnabled="True" SmallChange="0.05" LargeChange="0.05" Margin="5,0" />
          <TextBlock x:Name="LargeLabel" FontSize="9" FontWeight="Bold" VerticalAlignment="Center" />
        </StackPanel>
      </StackPanel>
      <Button x:Name="ActionButton" Grid.Column="6" Style="{StaticResource PaperButton}" VerticalAlignment="Center" />
    </Grid>
  </Border>
</UserControl>
