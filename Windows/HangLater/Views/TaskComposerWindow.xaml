<Window x:Class="HangLater.Windows.Views.TaskComposerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Hang something" Width="490" SizeToContent="Height" WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Icon="/HangLater;component/Resources/HangLater.ico">
  <Border Name="DialogShell" Background="{DynamicResource PaperBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12"><Grid Margin="29">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid MouseLeftButtonDown="Header_Drag"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="24"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,14,0"><TextBlock Name="Heading" Style="{DynamicResource DialogHeading}"/><TextBlock Name="Subtitle" Style="{DynamicResource DialogCopy}" Margin="0,7,0,0"/></StackPanel><Button Name="CloseButton" Grid.Column="1" Style="{DynamicResource DialogIconButton}" VerticalAlignment="Center" Click="Cancel_Click" IsCancel="True"><Image Name="CloseIcon"/></Button></Grid>
    <ScrollViewer Name="ComposerScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,18,0,0"><StackPanel>
      <StackPanel><TextBlock Name="TitleLabel" Style="{DynamicResource DialogLabel}"/><TextBox Name="TitleText" Style="{DynamicResource DialogInput}" Margin="0,9,0,0"/></StackPanel>
      <StackPanel Margin="0,20,0,0"><TextBlock Name="LinkLabel" Style="{DynamicResource DialogLabel}"/><TextBox Name="LinkText" Style="{DynamicResource DialogInput}" Margin="0,9,0,0" Tag="https://…"/></StackPanel>
      <StackPanel Margin="0,20,0,0"><TextBlock Name="NoteLabel" Style="{DynamicResource DialogLabel}"/><TextBox Name="NoteText" Style="{DynamicResource DialogInput}" Margin="0,9,0,0" Height="66" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"/></StackPanel>
      <StackPanel Margin="0,20,0,0"><TextBlock Name="TypeLabel" Style="{DynamicResource DialogLabel}"/><Border Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="11" Margin="0,9,0,0"><ComboBox Name="TypeBox" Style="{DynamicResource DialogCombo}" DisplayMemberPath="name" Height="22"/></Border></StackPanel>
      <CheckBox Name="ReminderCheck" Margin="0,20,0,0" FontFamily="{DynamicResource DialogCopyFont}" FontSize="11" Foreground="{DynamicResource InkBrush}" Checked="Reminder_Changed" Unchecked="Reminder_Changed"/>
      <Grid Name="ReminderTimePanel" Margin="0,12,0,0" Visibility="Collapsed"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="92"/></Grid.ColumnDefinitions><DatePicker Name="DueDate" FontFamily="{DynamicResource DialogCopyFont}" Foreground="{DynamicResource InkBrush}" Background="{DynamicResource RaisedBrush}" BorderBrush="{DynamicResource BorderBrush}" CalendarStyle="{DynamicResource DialogCalendar}"/><TextBox Name="DueTime" Grid.Column="2" Style="{DynamicResource DialogInput}" Padding="8" MinHeight="32"/></Grid>
      <TextBlock Name="ValidationText" Style="{DynamicResource DialogCopy}" Foreground="{DynamicResource InkBrush}" FontWeight="Bold" Margin="0,12,0,0" Visibility="Collapsed"/>
    </StackPanel></ScrollViewer>
    <StackPanel Name="Footer" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,27,0,0"><Button Name="CancelButton" Style="{DynamicResource DialogButton}" Margin="0,0,8,0" Click="Cancel_Click"/><Button Name="HangButton" Style="{DynamicResource DialogPrimaryButton}" Click="Hang_Click" IsDefault="True"/></StackPanel>
  </Grid></Border>
</Window>
