<?xml version="1.0" encoding="utf-8"?>
<Application x:Class="HangLater.Windows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options" ShutdownMode="OnExplicitShutdown" xmlns:windows="clr-namespace:HangLater.Windows;assembly=HangLater">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Views/OverlayScrollStyles.xaml" />
      </ResourceDictionary.MergedDictionaries>
      <!-- Arial Narrow is a condensed face inside the Arial family on Windows. -->
      <FontFamily x:Key="DisplayFont">Arial</FontFamily>
      <FontFamily x:Key="MonoFont">Courier New</FontFamily>
      <FontFamily x:Key="IconFont">Segoe Fluent Icons</FontFamily>
      <SolidColorBrush x:Key="InkBrush" Color="#EFEFE9" po:Freeze="False" />
      <SolidColorBrush x:Key="AccentBrush" Color="#EFEFE9" po:Freeze="False" />
      <SolidColorBrush x:Key="MutedBrush" Color="#B5B5AE" po:Freeze="False" />
      <SolidColorBrush x:Key="PaperBrush" Color="#212121" po:Freeze="False" />
      <SolidColorBrush x:Key="SidebarBrush" Color="#171717" po:Freeze="False" />
      <SolidColorBrush x:Key="PanelBrush" Color="#262626" po:Freeze="False" />
      <SolidColorBrush x:Key="RaisedBrush" Color="#282828" po:Freeze="False" />
      <SolidColorBrush x:Key="SearchBrush" Color="#272727" po:Freeze="False" />
      <SolidColorBrush x:Key="StageBrush" Color="#212121" po:Freeze="False" />
      <SolidColorBrush x:Key="RopeBrush" Color="#8C8C8C" po:Freeze="False" />
      <SolidColorBrush x:Key="DropTargetBrush" Color="#282828" po:Freeze="False" />
      <SolidColorBrush x:Key="BorderBrush" Color="#464641" po:Freeze="False" />
      <SolidColorBrush x:Key="DividerBrush" Color="#373734" po:Freeze="False" />
      <SolidColorBrush x:Key="SlipBrush" Color="#E9E3D3" />
      <SolidColorBrush x:Key="SlipInkBrush" Color="#171715" />
      <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        <Setter Property="TextOptions.TextRenderingMode" Value="ClearType" />
      </Style>
      <Style x:Key="{x:Type Button}" TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="13,9" />
        <Setter Property="Background" Value="{DynamicResource RaisedBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
      </Style>
      <Style x:Key="{x:Type TextBox}" TargetType="{x:Type TextBox}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="{DynamicResource SearchBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
      </Style>
      <Style x:Key="{x:Type ComboBox}" TargetType="{x:Type ComboBox}">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="8" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
