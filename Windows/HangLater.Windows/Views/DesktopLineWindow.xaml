<Window x:Class="HangLater.Windows.Views.DesktopLineWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="1200" Height="310" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" AllowDrop="True"
        DragOver="Window_DragOver" Drop="Window_Drop">
  <Border Background="#E6161616" BorderBrush="#77909090" BorderThickness="0,1,0,1">
    <Canvas x:Name="LineCanvas" ClipToBounds="True">
      <Line X1="0" Y1="105" X2="2200" Y2="132" Stroke="#BFBFBF" StrokeThickness="2"/>
      <Border x:Name="DropZone" Canvas.Top="15" Width="300" Height="68" Background="#DDE9E3D3">
        <Grid><Rectangle Stroke="#171715" StrokeThickness="2" StrokeDashArray="6,4"/><TextBlock x:Name="DropText" Text="📌  DRAG SOMETHING HERE" Foreground="#171715" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
      </Border>
    </Canvas>
  </Border>
</Window>
