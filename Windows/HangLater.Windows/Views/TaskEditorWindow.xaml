<Window x:Class="HangLater.Windows.Views.TaskEditorWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit" Width="650" Height="660" WindowStartupLocation="CenterOwner" Background="{StaticResource PaperBrush}" Icon="/Resources/HangLater.ico">
  <ScrollViewer><Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="Heading" Text="EDIT" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="24"/>
    <StackPanel Grid.Row="1" Margin="0,20,0,0"><TextBlock x:Name="TitleLabel"/><TextBox x:Name="TitleText" Margin="0,6,0,0"/></StackPanel>
    <StackPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock x:Name="LinkLabel"/><TextBox x:Name="LinkText" Margin="0,6,0,0"/></StackPanel>
    <StackPanel Grid.Row="3" Margin="0,16,0,0"><TextBlock x:Name="NoteLabel"/><TextBox x:Name="NoteText" Margin="0,6,0,0" AcceptsReturn="True" Height="95" TextWrapping="Wrap"/></StackPanel>
    <StackPanel Grid.Row="4" Margin="0,16,0,0"><TextBlock x:Name="TypeLabel"/><ComboBox x:Name="TypeBox" Margin="0,6,0,0" DisplayMemberPath="name"/></StackPanel>
    <CheckBox x:Name="ReminderCheck" Grid.Row="5" Margin="0,18,0,0" Checked="ReminderCheck_Changed" Unchecked="ReminderCheck_Changed"/>
    <Grid x:Name="ReminderTimePanel" Grid.Row="6" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="140"/></Grid.ColumnDefinitions><DatePicker x:Name="DueDate"/><TextBox x:Name="DueTime" Grid.Column="1" Margin="12,0,0,0"/></Grid>
    <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0"><Button x:Name="CancelButton" Click="Cancel_Click" Margin="0,0,8,0"/><Button x:Name="SaveButton" Click="Save_Click"/></StackPanel>
  </Grid></ScrollViewer>
</Window>
