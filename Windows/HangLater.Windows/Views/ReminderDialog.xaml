<Window x:Class="HangLater.Windows.Views.ReminderDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hang a Reminder" Width="650" Height="470" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource PaperBrush}" Icon="/Resources/HangLater.ico">
  <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="Heading" Text="HANG A REMINDER" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="24"/>
    <TextBlock x:Name="TitleLabel" Grid.Row="1" Margin="0,22,0,7"/><TextBox x:Name="TitleText" Grid.Row="2" FontSize="17"/>
    <StackPanel Grid.Row="3" Margin="0,14,0,0"><TextBlock x:Name="LinkLabel" Margin="0,0,0,7"/><TextBox x:Name="LinkText"/><TextBlock x:Name="LinkHint" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/></StackPanel>
    <Grid Grid.Row="4" Margin="0,20,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions><DatePicker x:Name="DueDate"/><TextBox x:Name="DueTime" Grid.Column="1" Margin="12,0,0,0" Text="15:00"/></Grid>
    <TextBlock x:Name="Footnote" Grid.Row="5" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="RemoveButton" Click="Remove_Click" Margin="0,0,8,0" Visibility="Collapsed"/><Button x:Name="CancelButton" Click="Cancel_Click" Margin="0,0,8,0"/><Button x:Name="HangButton" Click="Hang_Click"/></StackPanel>
  </Grid>
</Window>
