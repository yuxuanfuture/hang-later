<Window x:Class="HangLater.Windows.Views.IdeaDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hang an Idea" Width="560" Height="270" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="{StaticResource PaperBrush}" Icon="/Resources/HangLater.ico">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="Heading" Text="HANG AN IDEA" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="24"/>
    <TextBox x:Name="IdeaText" Grid.Row="1" Margin="0,20,0,20" FontSize="20" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Center"/>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="CancelButton" Click="Cancel_Click" Margin="0,0,8,0">Cancel</Button><Button x:Name="HangButton" Click="Hang_Click">Hang it</Button></StackPanel>
  </Grid>
</Window>
