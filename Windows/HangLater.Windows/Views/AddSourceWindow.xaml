<Window x:Class="HangLater.Windows.Views.AddSourceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hang something" Width="720" Height="610" MinWidth="620" MinHeight="520" WindowStartupLocation="CenterOwner" Background="{StaticResource PaperBrush}" Icon="/Resources/HangLater.ico">
  <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock x:Name="Heading" FontFamily="{StaticResource DisplayFont}" FontWeight="Bold" FontSize="26" Text="HANG SOMETHING"/>
    <UniformGrid Grid.Row="1" Columns="4" Margin="0,22,0,18"><Button x:Name="IdeaButton" Click="Idea_Click" Margin="0,0,8,0"/><Button x:Name="ReminderButton" Click="Reminder_Click" Margin="0,0,8,0"/><Button x:Name="FileButton" Click="File_Click" Margin="0,0,8,0"/><Button x:Name="RefreshWindowsButton" Click="RefreshWindows_Click"/></UniformGrid>
    <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBox x:Name="TaskTitle" FontSize="17"/><TextBox x:Name="TaskNote" Grid.Row="1" Height="78" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,12,0,16"/>
      <ListBox x:Name="WindowsList" Grid.Row="2" DisplayMemberPath="Display" Background="#222" Foreground="{StaticResource InkBrush}" BorderBrush="{StaticResource BorderBrush}"/>
    </Grid>
    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0"><Button x:Name="CancelButton" Click="Cancel_Click" Margin="0,0,8,0"/><Button x:Name="AddTaskButton" Click="AddTask_Click" Margin="0,0,8,0"/><Button x:Name="CaptureButton" Click="Capture_Click"/></StackPanel>
  </Grid>
</Window>
