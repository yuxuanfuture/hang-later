<Window x:Class="HangLater.Windows.Views.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="980" Height="760" MinWidth="780" MinHeight="600" WindowStartupLocation="CenterOwner" Background="{StaticResource PaperBrush}" Icon="/Resources/HangLater.ico">
  <Grid Margin="30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel><TextBlock x:Name="Heading" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="Bold"/><TextBlock x:Name="Subtitle" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,6,0,20"/></StackPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <StackPanel x:Name="SectionMenu" Margin="0,20,22,0"><TextBlock x:Name="SectionsLabel" FontWeight="Bold" Foreground="{StaticResource MutedBrush}" Margin="10,0,0,12"/>
        <Button x:Name="DesktopNav" Click="DesktopNav_Click" HorizontalContentAlignment="Left" Margin="0,0,0,8"/><Button x:Name="TriggersNav" Click="TriggersNav_Click" HorizontalContentAlignment="Left" Margin="0,0,0,8"/><Button x:Name="WorkdayNav" Click="WorkdayNav_Click" HorizontalContentAlignment="Left" Margin="0,0,0,8"/><Button x:Name="TypesNav" Click="TypesNav_Click" HorizontalContentAlignment="Left"/>
      </StackPanel><Border Grid.Column="1" Background="{StaticResource BorderBrush}"/>
      <ScrollViewer x:Name="SettingsScroll" Grid.Column="2" Margin="28,0,0,0" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,20,18,30">
        <StackPanel x:Name="DesktopSection"><TextBlock x:Name="DesktopHeading" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="DesktopCopy" Foreground="{StaticResource MutedBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,16"/>
          <CheckBox x:Name="KeepVisibleCheck" FontSize="15" Padding="12" Background="{StaticResource RaisedBrush}"/>
          <TextBlock x:Name="HeightLabel" Margin="0,18,0,8" FontWeight="Bold"/><Slider x:Name="HeightSlider" Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True"/><Grid><TextBlock x:Name="TopLabel" Foreground="{StaticResource MutedBrush}"/><TextBlock x:Name="BottomLabel" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}"/></Grid>
        </StackPanel>
        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,28"/>
        <StackPanel x:Name="TriggersSection"><TextBlock x:Name="TriggersHeading" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="TriggersCopy" Foreground="{StaticResource MutedBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,16"/>
          <TextBlock x:Name="HotKeyLabel" FontWeight="Bold"/><TextBox x:Name="HotKeyBox" Margin="0,7,0,7"/><TextBlock x:Name="HotKeyHint" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
          <CheckBox x:Name="EdgeHoverCheck" FontSize="15" Margin="0,20,0,12"/><TextBlock x:Name="ZoneLabel" FontWeight="Bold"/><ComboBox x:Name="EdgeZoneBox" Margin="0,7,0,7"><ComboBoxItem/><ComboBoxItem/><ComboBoxItem/><ComboBoxItem/></ComboBox><TextBlock x:Name="EdgeHint" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
        </StackPanel>
        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,28"/>
        <StackPanel x:Name="WorkdaySection"><TextBlock x:Name="WorkdayHeading" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="WorkdayCopy" Foreground="{StaticResource MutedBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,16"/>
          <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="50"/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="StartLabel" FontWeight="Bold"/><TextBox x:Name="StartTime" Text="00:00" Margin="0,7,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="→" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6"/><StackPanel Grid.Column="2"><TextBlock x:Name="EndLabel" FontWeight="Bold"/><TextBox x:Name="EndTime" Text="00:00" Margin="0,7,0,0"/></StackPanel></Grid>
          <CheckBox x:Name="FollowingDayCheck" Margin="0,14,0,0" FontSize="15"/>
        </StackPanel>
        <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,28"/>
        <StackPanel x:Name="TypesSection"><TextBlock x:Name="TypesHeading" FontFamily="{StaticResource DisplayFont}" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="TypesCopy" Foreground="{StaticResource MutedBrush}" FontSize="14" TextWrapping="Wrap" Margin="0,6,0,16"/>
          <Border Background="#E9E3D3" Height="58"><TextBlock x:Name="DefaultTypeLabel" Foreground="#171715" VerticalAlignment="Center" Margin="16,0" FontWeight="Bold"/></Border>
          <StackPanel x:Name="TaskTypesPanel" Margin="0,14,0,0"/><Button x:Name="AddTypeButton" Click="AddType_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/>
          <TextBlock x:Name="PaletteLabel" FontWeight="Bold" Margin="0,22,0,10"/><WrapPanel x:Name="PalettePanel"/>
        </StackPanel>
      </StackPanel></ScrollViewer>
    </Grid>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button x:Name="CancelButton" Click="Cancel_Click" Margin="0,0,8,0"/><Button x:Name="SaveButton" Click="Save_Click"/></StackPanel>
  </Grid>
</Window>
